from nicegui import ui
import paho.mqtt.client as mqtt
import random


# ==========================================
# MQTT SETTINGS
# ==========================================

MQTT_SERVER = "10.201.48.133"

SHOT_TOPIC = "game/shot"
TARGET_TOPIC = "game/target"
PLAYER_TOPIC = "game/player"
RESULT_TOPIC = "game/result"


# ==========================================
# GAME DATA
# ==========================================

target = 0

player1 = None
player2 = None

score1 = 0
score2 = 0

current_player = 1


# ==========================================
# NICEGUI
# ==========================================

ui.label("DISTANCE DUEL").classes(
    "text-4xl font-bold"
)

ui.separator()


# TARGET
ui.label("TARGET").classes(
    "text-xl"
)

target_label = ui.label("-- cm").classes(
    "text-5xl font-bold"
)


ui.separator()


# PLAYERS
with ui.row().classes(
    "w-full justify-around"
):

    # PLAYER 1
    with ui.column().classes(
        "items-center"
    ):

        ui.label("PLAYER 1").classes(
            "text-2xl font-bold"
        )

        player1_label = ui.label(
            "-- cm"
        ).classes(
            "text-4xl"
        )

        player1_error_label = ui.label(
            "Error: --"
        )

        player1_score_label = ui.label(
            "Score: 0"
        )


    # PLAYER 2
    with ui.column().classes(
        "items-center"
    ):

        ui.label("PLAYER 2").classes(
            "text-2xl font-bold"
        )

        player2_label = ui.label(
            "-- cm"
        ).classes(
            "text-4xl"
        )

        player2_error_label = ui.label(
            "Error: --"
        )

        player2_score_label = ui.label(
            "Score: 0"
        )


ui.separator()


turn_label = ui.label(
    "WAITING..."
).classes(
    "text-2xl font-bold"
)


winner_label = ui.label(
    ""
).classes(
    "text-3xl font-bold"
)


# ==========================================
# NEW ROUND
# ==========================================

def new_round():

    global target
    global player1
    global player2
    global current_player

    player1 = None
    player2 = None

    current_player = 1

    # Random target
    target = random.randint(
        20,
        100
    )


    # Update GUI
    target_label.set_text(
        str(target) + " cm"
    )

    player1_label.set_text(
        "-- cm"
    )

    player2_label.set_text(
        "-- cm"
    )

    player1_error_label.set_text(
        "Error: --"
    )

    player2_error_label.set_text(
        "Error: --"
    )

    turn_label.set_text(
        "PLAYER 1 TURN"
    )

    winner_label.set_text(
        ""
    )


    # MQTT -> ESP32
    mqtt_client.publish(
        TARGET_TOPIC,
        str(target)
    )

    mqtt_client.publish(
        PLAYER_TOPIC,
        "1"
    )


    print()
    print("====================")
    print("NEW ROUND")
    print("TARGET:", target)
    print("PLAYER 1")
    print("====================")


# ==========================================
# MQTT MESSAGE
# ==========================================

def on_message(
    client,
    userdata,
    msg
):

    global player1
    global player2
    global current_player
    global score1
    global score2


    try:

        distance = float(
            msg.payload.decode()
        )

    except ValueError:

        return


    print(
        "Received:",
        distance,
        "cm"
    )


    # ======================================
    # PLAYER 1
    # ======================================

    if player1 is None:

        player1 = distance

        error1 = abs(
            player1 - target
        )

        player1_label.set_text(
            str(player1) + " cm"
        )

        player1_error_label.set_text(
            "Error: "
            + str(round(error1, 1))
            + " cm"
        )


        current_player = 2

        turn_label.set_text(
            "PLAYER 2 TURN"
        )


        client.publish(
            PLAYER_TOPIC,
            "2"
        )


    # ======================================
    # PLAYER 2
    # ======================================

    elif player2 is None:

        player2 = distance

        error1 = abs(
            player1 - target
        )

        error2 = abs(
            player2 - target
        )


        player2_label.set_text(
            str(player2) + " cm"
        )

        player2_error_label.set_text(
            "Error: "
            + str(round(error2, 1))
            + " cm"
        )


        # ==================================
        # WINNER
        # ==================================

        if error1 < error2:

            winner = "PLAYER 1 WINS!"

            score1 += 1


        elif error2 < error1:

            winner = "PLAYER 2 WINS!"

            score2 += 1


        else:

            winner = "DRAW!"


        player1_score_label.set_text(
            "Score: " + str(score1)
        )

        player2_score_label.set_text(
            "Score: " + str(score2)
        )


        winner_label.set_text(
            winner
        )

        turn_label.set_text(
            "ROUND FINISHED"
        )


        client.publish(
            RESULT_TOPIC,
            winner.replace("!", "")
        )


        print()
        print("TARGET:", target)
        print("PLAYER 1:", player1)
        print("PLAYER 2:", player2)
        print(winner)


# ==========================================
# MQTT CLIENT
# ==========================================

mqtt_client = mqtt.Client()

mqtt_client.on_message = (
    on_message
)

mqtt_client.connect(
    MQTT_SERVER,
    1883
)

mqtt_client.subscribe(
    SHOT_TOPIC
)

mqtt_client.loop_start()


# ==========================================
# NEW ROUND BUTTON
# ==========================================

ui.button(
    "NEW ROUND",
    on_click=new_round
).classes(
    "text-xl"
)


# ==========================================
# START FIRST ROUND
# ==========================================

ui.timer(
    1,
    new_round,
    once=True
)


# ==========================================
# START NICEGUI
# ==========================================

ui.run(
    host="0.0.0.0",
    port=8080,
    title="Distance Duel",
    reload=False
)
